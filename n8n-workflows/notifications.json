      "typeVersion": 4.2,
      "position": [
        520,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const J = $input.first().json;\nconst req = $('Webhook').first().json.body; const c = J;\nconst T = {complaint_submitted:'Complaint submitted', complaint_acknowledged:'Complaint acknowledged', authority_assigned:'Authority assigned', information_requested:'Information requested',\n authority_transferred:'Authority transferred', deadline_approaching:'Deadline approaching', case_escalated:'Case escalated', response_received:'Response received', decision_made:'Decision made',\n appeal_submitted:'Appeal submitted', appeal_outcome:'Appeal outcome', legal_assistance:'Legal assistance available', citizen_replied:'Citizen replied', intake:'Complaint received'};\nconst title = T[req.type] || T[req.event] || 'Case update';\nconst text = `CivicShield ${c.code || ''}: ${title}. Status: ${c.status}. Open the app for details. (Automated message - not a finding about anyone's conduct.)`;\nconst out = [{json: {mode:'inapp', complaint_id: c.id, user_id: c.citizen_id, type: req.type || req.event, title, message: text, channel: 'in_app', skip: req.source === 'audit_trail' || !!req.skip_inapp}}];\nfor (const ch of (req.channels || [])) out.push({json: {mode:'external', complaint_id: c.id, user_id: c.citizen_id, type: req.type || req.event, title, message: `[${ch.toUpperCase()} simulated -> ${ch === 'email' ? c.citizen_email : c.citizen_phone}] ` + text, channel: ch + '_simulated'}});\nreturn out;"
      },
      "id": "bd36857c-dacb-51a6-9795-e71d3c9e7947",
