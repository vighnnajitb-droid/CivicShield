    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const J = $input.first().json;\nconst b = J.body || {};\nif (!Number.isInteger(b.complaint_id) || !/^CS-\\d{4}-\\d{6}$/.test(b.code || '')) throw new Error('Invalid intake payload');\nreturn [{json: {complaint_id: b.complaint_id, code: b.code, received_at: new Date().toISOString(), workflow_execution: $execution.id}}];"
      },
      "id": "4f527b69-710c-54e8-beef-40da82c1648a",
      "name": "Validate payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_WEBHOOK_BASE }}/ai-analysis",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Key",
              "value": "={{ $env.INTERNAL_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({complaint_id: $json.complaint_id, mode: 'triage'}) }}"
      },
      "id": "27be1089-1502-51e3-b4d2-66acdcb68bda",
      "name": "Triage (advisory AI)",
