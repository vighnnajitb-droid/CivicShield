        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({complaint_id: $('Validate payload').first().json.complaint_id, triage: {priority: ($json.analysis||{}).advisory_priority || 'normal', label: ($json.analysis||{}).label}}) }}"
