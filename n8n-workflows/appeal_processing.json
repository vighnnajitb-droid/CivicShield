        "jsonBody": "={{ JSON.stringify({complaint_id: $json.appeal.complaint_id, event_type: 'appeal_workflow_processed', metadata: {appeal_id: $json.appeal.id, review_authority: $json.appeal.review_authority, deadline: $json.appeal.deadline, chain_valid: $json.chain.valid}}) }}"
      },
      "id": "c6e3eccd-aad4-5427-829e-02a7faad55fb",
