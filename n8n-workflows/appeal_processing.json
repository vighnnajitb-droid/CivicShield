        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({complaint_id: $('Webhook').first().json.body.complaint_id, type: 'appeal_submitted', channels: ['email','sms'], skip_inapp: true}) }}"
