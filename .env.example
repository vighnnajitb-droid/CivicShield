# Streamlit frontend; local FastAPI defaults to http://127.0.0.1:8000.
BACKEND_URL=http://127.0.0.1:8000

# Backend and n8n must use the same INTERNAL_API_KEY.
JWT_SECRET=replace-with-a-long-random-secret
INTERNAL_API_KEY=replace-with-a-different-long-random-secret
N8N_WEBHOOK_BASE=http://localhost:5678/webhook

# Configure these on the n8n host (not in Streamlit Cloud):
# BACKEND_URL=https://your-civicshield-api.onrender.com
# N8N_WEBHOOK_BASE=https://your-n8n-host.example/webhook